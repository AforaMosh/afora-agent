{
  "name": "@afora/teams-meetings",
  "version": "2026.8.1",
  "description": "Afora Microsoft Teams browser meeting participant plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AforaMosh/afora-agent"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@afora/plugin-sdk": "workspace:*",
    "afora-agent": "workspace:*"
  },
  "peerDependencies": {
    "afora-agent": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "afora": {
      "optional": true
    }
  },
  "afora": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@afora/teams-meetings",
      "npmSpec": "@afora/teams-meetings",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.2"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "aforaVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
