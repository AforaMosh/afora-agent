{
  "name": "@afora/voice-call",
  "version": "2026.8.1",
  "description": "Afora voice-call plugin for Twilio, Telnyx, and Plivo phone calls.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AforaMosh/afora-agent"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.6",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@afora/plugin-sdk": "workspace:*",
    "afora-agent": "workspace:*"
  },
  "peerDependencies": {
    "afora-agent": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "afora": {
      "optional": true
    }
  },
  "afora": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@afora/voice-call",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "aforaVersion": "2026.8.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
