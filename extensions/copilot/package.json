{
  "name": "@afora/copilot",
  "version": "2026.8.1",
  "description": "Afora GitHub Copilot agent runtime plugin (registers a `github-copilot` AgentHarness backed by @github/copilot-sdk over JSON-RPC to the GitHub Copilot CLI)",
  "repository": {
    "type": "git",
    "url": "https://github.com/AforaMosh/afora-agent"
  },
  "type": "module",
  "dependencies": {
    "@github/copilot-sdk": "1.0.7"
  },
  "devDependencies": {
    "@afora/plugin-sdk": "workspace:*"
  },
  "afora": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@afora/copilot",
      "npmSpec": "@afora/copilot",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "aforaVersion": "2026.8.1",
      "bundledDist": false
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
