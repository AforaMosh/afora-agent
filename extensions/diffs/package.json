{
  "name": "@afora/diffs",
  "version": "2026.8.1",
  "description": "Afora read-only diff viewer plugin and file renderer for agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AforaMosh/afora-agent"
  },
  "type": "module",
  "dependencies": {
    "@pierre/diffs": "1.2.12",
    "@shikijs/langs": "4.3.1",
    "playwright-core": "1.62.1",
    "typebox": "1.3.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@afora/plugin-sdk": "workspace:*"
  },
  "afora": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@afora/diffs",
      "localPath": "extensions/diffs",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.30"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "assetScripts": {
      "build": "node --import tsx ../../scripts/build-diffs-viewer-runtime.mts curated"
    },
    "build": {
      "aforaVersion": "2026.8.1",
      "staticAssets": [
        {
          "source": "./assets/viewer-runtime.js",
          "output": "assets/viewer-runtime.js"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
