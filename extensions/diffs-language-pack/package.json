{
  "name": "@afora/diffs-language-pack",
  "version": "2026.8.1",
  "description": "Afora diffs viewer syntax highlighting language pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/AforaMosh/afora-agent"
  },
  "type": "module",
  "devDependencies": {
    "@afora/plugin-sdk": "workspace:*"
  },
  "afora": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@afora/diffs-language-pack",
      "clawhubSpec": "clawhub:@afora/diffs-language-pack",
      "localPath": "extensions/diffs-language-pack",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.27"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "assetScripts": {
      "build": "node --import tsx ../../scripts/build-diffs-viewer-runtime.mts full"
    },
    "build": {
      "aforaVersion": "2026.8.1",
      "staticAssets": [
        {
          "source": "./assets/viewer-runtime.js",
          "output": "assets/viewer-runtime.js"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
