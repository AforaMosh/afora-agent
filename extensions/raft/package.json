{
  "name": "@afora/raft",
  "version": "2026.8.1",
  "description": "Afora Raft channel plugin for Raft CLI wake bridges.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AforaMosh/afora-agent"
  },
  "type": "module",
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@afora/plugin-sdk": "workspace:*",
    "afora-agent": "workspace:*"
  },
  "peerDependencies": {
    "afora-agent": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "afora": {
      "optional": true
    }
  },
  "afora": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "install": {
      "npmSpec": "@afora/raft",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "aforaVersion": "2026.8.1"
    },
    "channel": {
      "id": "raft",
      "configuredState": {
        "env": {
          "anyOf": [
            "RAFT_PROFILE"
          ]
        }
      },
      "label": "Raft",
      "selectionLabel": "Raft (CLI wake bridge)",
      "docsPath": "/channels/raft",
      "docsLabel": "raft",
      "blurb": "Raft CLI wake bridge for human and agent collaboration.",
      "order": 72,
      "setup": {
        "fields": [
          {
            "key": "profile",
            "kind": "string",
            "cli": {
              "flags": "--profile <profile>",
              "description": "Raft CLI profile"
            }
          }
        ]
      }
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
