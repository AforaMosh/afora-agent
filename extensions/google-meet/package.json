{
  "name": "@afora/google-meet",
  "version": "2026.8.1",
  "description": "Afora Google Meet participant plugin for joining calls through Chrome or Twilio transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AforaMosh/afora-agent"
  },
  "type": "module",
  "dependencies": {
    "jszip": "3.10.1",
    "pretty-ms": "9.3.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@afora/plugin-sdk": "workspace:*",
    "afora-agent": "workspace:*"
  },
  "peerDependencies": {
    "afora-agent": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "afora": {
      "optional": true
    }
  },
  "afora": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@afora/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.20"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "aforaVersion": "2026.8.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
