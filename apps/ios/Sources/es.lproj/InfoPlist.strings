/* Afora source: "Afora uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "Afora usa tus calendarios para mostrar eventos y contexto de programación cuando activas el acceso al calendario.";
/* Afora source: "Afora uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "Afora usa tus calendarios para mostrar eventos y contexto de programación cuando activas el acceso al calendario.";
/* Afora source: "Afora uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "Afora usa tus calendarios para agregar eventos cuando activas el acceso al calendario.";
/* Afora source: "Afora uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Afora usa la cámara cuando escaneas un código QR de configuración de Gateway o pides a tu Gateway emparejado o asistente que capture una foto o un video corto desde este iPhone, por ejemplo, para conectarte a tu Gateway o mostrarle a tu asistente un documento, la pantalla de un dispositivo o un espacio de trabajo.";
/* Afora source: "Afora uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Afora usa tus contactos para que puedas buscar y hacer referencia a personas mientras usas el asistente.";
/* Afora source: "Afora discovers and connects to your Afora gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Afora descubre y se conecta a tu gateway de Afora en la red local.";
/* Afora source: "Afora can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Afora puede compartir tu ubicación en segundo plano cuando activas Siempre.";
/* Afora source: "Afora uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Afora usa tu ubicación cuando permites compartir la ubicación.";
/* Afora source: "Afora uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Afora usa el micrófono para chat en tiempo real, activación por voz, pulsar para hablar y notas de voz.";
/* Afora source: "Afora may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Afora puede usar datos de movimiento para admitir interacciones y automatizaciones conscientes del dispositivo.";
/* Afora source: "Afora reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Afora lee tus pasos, sueño, frecuencia cardíaca en reposo y entrenamientos desde la app Salud de Apple para crear los resúmenes que solicites y enviarlos a través de tu Gateway al proveedor de IA configurado.";
/* Afora source: "Afora does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Afora no escribe en la app Salud de Apple. Utiliza datos de solo lectura para crear los resúmenes que solicites y enviarlos a través de tu Gateway al proveedor de IA configurado.";
/* Afora source: "Afora lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Afora permite que tu asistente lea las fotos que autorices y te permite elegir fotos para compartir.";
/* Afora source: "Afora uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Afora usa tus recordatorios para listar, agregar y completar tareas cuando habilitas el acceso a recordatorios.";
/* Afora source: "Afora uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Afora usa el reconocimiento de voz en el dispositivo para el modo de conversación y la activación por voz.";
