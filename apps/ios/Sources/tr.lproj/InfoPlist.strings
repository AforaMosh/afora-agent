/* Afora source: "Afora uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "Afora, takvim erişimini etkinleştirdiğinizde etkinlikleri ve planlama bağlamını göstermek için takvimlerinizi kullanır.";
/* Afora source: "Afora uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "Afora, takvim erişimini etkinleştirdiğinizde etkinlikleri ve planlama bağlamını göstermek için takvimlerinizi kullanır.";
/* Afora source: "Afora uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "Afora, takvim erişimini etkinleştirdiğinizde etkinlik eklemek için takvimlerinizi kullanır.";
/* Afora source: "Afora uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Afora, bir Gateway kurulum QR kodunu taradığınızda veya eşleştirilmiş Gateway'inizden ya da asistanınızdan bu iPhone'dan fotoğraf veya kısa video çekmesini istediğinizde kamerayı kullanır; örneğin Gateway'inize bağlanmak veya asistanınıza bir belge, cihaz ekranı ya da çalışma alanı göstermek için.";
/* Afora source: "Afora uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Afora, asistanı kullanırken kişileri arayabilmeniz ve onlara referans verebilmeniz için kişilerinizi kullanır.";
/* Afora source: "Afora discovers and connects to your Afora gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Afora, yerel ağdaki Afora gateway'inizi keşfeder ve ona bağlanır.";
/* Afora source: "Afora can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Afora, Her Zaman seçeneğini etkinleştirdiğinizde konumunuzu arka planda paylaşabilir.";
/* Afora source: "Afora uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Afora, konum paylaşımına izin verdiğinizde konumunuzu kullanır.";
/* Afora source: "Afora uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Afora mikrofonu gerçek zamanlı sohbet, sesle uyandırma, bas-konuş ve sesli notlar için kullanır.";
/* Afora source: "Afora may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Afora, cihaza duyarlı etkileşimleri ve otomasyonları desteklemek için hareket verilerini kullanabilir.";
/* Afora source: "Afora reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Afora, istediğiniz özetleri oluşturmak ve bunları Gateway üzerinden yapılandırılmış AI sağlayıcınıza göndermek için Apple Sağlık uygulamasındaki adım, uyku, dinlenme kalp atış hızı ve antrenman verilerinizi okur.";
/* Afora source: "Afora does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Afora, Apple Sağlık uygulamasına veri yazmaz. İstediğiniz özetleri oluşturmak ve bunları Gateway üzerinden yapılandırılmış AI sağlayıcınıza göndermek için salt okunur verileri kullanır.";
/* Afora source: "Afora lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Afora, asistanınızın izin verdiğiniz fotoğrafları okumasını sağlar ve paylaşılacak fotoğrafları seçmenize olanak tanır.";
/* Afora source: "Afora uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Afora, anımsatıcılara erişimi etkinleştirdiğinizde görevleri listelemek, eklemek ve tamamlamak için anımsatıcılarınızı kullanır.";
/* Afora source: "Afora uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Afora, konuşma modu ve sesle uyandırma için aygıt üzerinde konuşma tanımayı kullanır.";
