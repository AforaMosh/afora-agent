/* Afora source: "Afora uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Afora використовує камеру, коли ви скануєте QR-код налаштування Gateway або просите спарений Gateway чи помічника зробити фото або коротке відео з цього iPhone, наприклад щоб підключитися до вашого Gateway або показати помічнику документ, екран пристрою чи робочий простір.";
/* Afora source: "Afora uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Afora використовує ваші контакти, щоб ви могли шукати людей і посилатися на них під час використання помічника.";
/* Afora source: "Afora discovers and connects to your Afora gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Afora виявляє та підключається до вашого Afora gateway у локальній мережі.";
/* Afora source: "Afora can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Afora може ділитися вашим місцезнаходженням у фоновому режимі, коли ви вмикаєте «Завжди».";
/* Afora source: "Afora uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Afora використовує ваше місцезнаходження, коли ви дозволяєте ділитися місцезнаходженням.";
/* Afora source: "Afora uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Afora використовує мікрофон для чату в реальному часі, голосового пробудження, режиму push-to-talk та голосових нотаток.";
/* Afora source: "Afora may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Afora може використовувати дані про рух для підтримки взаємодій і автоматизацій з урахуванням пристрою.";
/* Afora source: "Afora reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Afora зчитує дані про ваші кроки, сон, пульс у стані спокою та тренування з програми Apple Health, щоб створювати запитані вами зведення й надсилати їх через ваш Gateway налаштованому постачальнику ШІ.";
/* Afora source: "Afora does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Afora не записує дані до програми Apple Health. Він використовує дані лише для читання, щоб створювати запитані вами зведення й надсилати їх через ваш Gateway налаштованому постачальнику ШІ.";
/* Afora source: "Afora lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Afora дає змогу вашому асистенту читати дозволені вами фото й дає вам змогу вибирати фото для надсилання.";
/* Afora source: "Afora uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Afora використовує ваші нагадування, щоб переглядати, додавати та завершувати завдання, коли ви вмикаєте доступ до нагадувань.";
/* Afora source: "Afora uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Afora використовує розпізнавання мовлення на пристрої для режиму розмови та голосової активації.";
