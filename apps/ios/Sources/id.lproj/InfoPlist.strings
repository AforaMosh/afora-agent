/* Afora source: "Afora uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Afora menggunakan mikrofon untuk obrolan realtime, voice wake, push-to-talk, dan pesan suara.";
/* Afora source: "Afora may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Afora dapat menggunakan data gerak untuk mendukung interaksi dan automasi yang sadar perangkat.";
/* Afora source: "Afora reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Afora membaca data langkah, tidur, detak jantung saat istirahat, dan olahraga Anda dari aplikasi Apple Health untuk membuat ringkasan yang Anda minta dan mengirimkannya melalui Gateway Anda ke penyedia AI yang dikonfigurasi.";
/* Afora source: "Afora does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Afora tidak menulis data ke aplikasi Apple Health. Afora menggunakan data hanya-baca untuk membuat ringkasan yang Anda minta dan mengirimkannya melalui Gateway Anda ke penyedia AI yang dikonfigurasi.";
/* Afora source: "Afora lets your assistant read photos you allow and lets you choose photos to share." */
