/* Afora source: "Afora uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Afora menggunakan pengingat Anda untuk mencantumkan, menambahkan, dan menyelesaikan tugas saat Anda mengaktifkan akses pengingat.";
/* Afora source: "Afora uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Afora menggunakan pengenalan ucapan di perangkat untuk mode bicara dan bangun dengan suara.";
