/* Afora source: "Afora uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "जब आप Gateway सेटअप QR कोड स्कैन करते हैं या अपने paired Gateway या assistant से इस iPhone से फ़ोटो या छोटा वीडियो कैप्चर करने के लिए कहते हैं, तो Afora कैमरे का उपयोग करता है, उदाहरण के लिए आपके Gateway से कनेक्ट करने या आपके assistant को कोई दस्तावेज़, डिवाइस स्क्रीन, या कार्यक्षेत्र दिखाने के लिए.";
/* Afora source: "Afora uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Afora आपके संपर्कों का उपयोग करता है ताकि आप assistant का उपयोग करते समय लोगों को खोज और संदर्भित कर सकें.";
/* Afora source: "Afora discovers and connects to your Afora gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Afora स्थानीय नेटवर्क पर आपके Afora gateway को खोजता है और उससे कनेक्ट करता है.";
/* Afora source: "Afora can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "जब आप Always सक्षम करते हैं, तो Afora पृष्ठभूमि में आपका स्थान साझा कर सकता है.";
/* Afora source: "Afora uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "जब आप स्थान साझा करने की अनुमति देते हैं, तो Afora आपके स्थान का उपयोग करता है.";
/* Afora source: "Afora uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Afora माइक्रोफ़ोन का उपयोग रियलटाइम चैट, वॉइस वेक, पुश-टू-टॉक और वॉइस नोट्स के लिए करता है।";
/* Afora source: "Afora may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Afora device-aware इंटरैक्शन और ऑटोमेशन का समर्थन करने के लिए motion data का उपयोग कर सकता है.";
/* Afora source: "Afora reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Afora आपके अनुरोधित सारांश बनाने के लिए Apple Health ऐप से आपके कदमों, नींद, आराम की हृदय गति और वर्कआउट को पढ़ता है और उन्हें आपके Gateway के माध्यम से आपके कॉन्फ़िगर किए गए AI प्रदाता को भेजता है।";
/* Afora source: "Afora does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Afora Apple Health ऐप में कुछ भी नहीं लिखता है। यह आपके अनुरोधित सारांश बनाने के लिए केवल-पढ़ने योग्य डेटा का उपयोग करता है और उन्हें आपके Gateway के माध्यम से आपके कॉन्फ़िगर किए गए AI प्रदाता को भेजता है।";
/* Afora source: "Afora lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Afora आपके असिस्टेंट को आपकी अनुमति वाली फ़ोटो पढ़ने देता है और आपको साझा करने के लिए फ़ोटो चुनने देता है।";
/* Afora source: "Afora uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "जब आप रिमाइंडर एक्सेस सक्षम करते हैं, तो Afora आपके रिमाइंडर का उपयोग कार्यों को सूचीबद्ध करने, जोड़ने और पूरा करने के लिए करता है।";
/* Afora source: "Afora uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Afora टॉक मोड और वॉइस वेक के लिए ऑन-डिवाइस स्पीच रिकग्निशन का उपयोग करता है।";
