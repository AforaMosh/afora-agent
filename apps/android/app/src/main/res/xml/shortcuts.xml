<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability
        android:name="custom.actions.intent.ASK_AFORA"
        app:queryPatterns="@array/ask_afora_query_patterns">
        <intent
            android:action="ai.afora.app.action.ASK_AFORA"
            android:targetPackage="@string/application_id"
            android:targetClass="ai.afora.app.MainActivity">
            <parameter
                android:name="prompt"
                android:key="prompt"
                android:mimeType="https://schema.org/Text"
                android:required="true" />
        </intent>
    </capability>
</shortcuts>
